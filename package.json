{
  "name": "ahd",
  "private": true,
  "version": "0.1.4",
  "description": "3ahd — a calm prayer-times companion for the desktop: adhan, widget, Quran, adhkar and qibla.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "check:adhan": "node scripts/check-adhan.ts",
    "check:release": "node scripts/check-adhan.ts --release",
    "release": "node scripts/release.ts",
    "icons": "node scripts/build-icons.ts",
    "data:cities": "node data-pipeline/build-cities.ts",
    "data:adhkar": "node data-pipeline/build-adhkar.ts",
    "data:fixtures": "node data-pipeline/fetch-aladhan-fixtures.ts",
    "data:quran": "node data-pipeline/build-quran.ts",
    "data:fonts": "node data-pipeline/build-shaping-fonts.ts",
    "data:library": "node data-pipeline/build-library-catalog.ts"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/changa": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "@tabby_ai/hijri-converter": "^1.0.5",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "adhan": "^4.4.6",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "harfbuzzjs": "^1.6.2",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "magvar": "^2.2.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
